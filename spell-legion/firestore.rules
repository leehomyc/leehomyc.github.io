rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function registered() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function nonnegative(v) { return v is number && v >= 0; }
    function validRun(r) {
      return r.keys().hasAll(['name','cls','map','diff','mode','time','kills','bosses','level','combo','relics','score','day','ts','uid'])
        && r.uid == request.auth.uid
        && r.name is string && r.name.size() <= 16
        && r.cls is string && r.cls.size() <= 20 && r.map is string && r.map.size() <= 20
        && r.diff is string && r.diff.size() <= 10 && r.mode is string && r.mode.size() <= 10
        && nonnegative(r.time) && nonnegative(r.kills) && nonnegative(r.level)
        && nonnegative(r.bosses) && nonnegative(r.combo) && nonnegative(r.relics)
        && nonnegative(r.score) && r.day is int && r.ts == request.time;
    }
    match /saves/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if registered() && request.auth.uid == uid && request.resource.data.guest == false;
      allow delete: if registered() && request.auth.uid == uid;
    }
    match /runs/{runId} {
      allow read: if true;
      allow create: if registered() && validRun(request.resource.data);
      allow update, delete: if false;
    }
    match /days/{day}/runs/{runId} {
      allow read: if true;
      allow create: if registered() && validRun(request.resource.data);
      allow update, delete: if false;
    }
    function friends(a, b) {
      let one = /databases/$(database)/documents/friendRequests/$(a + '_' + b);
      let two = /databases/$(database)/documents/friendRequests/$(b + '_' + a);
      return (exists(one) && get(one).data.status == 'accepted') || (exists(two) && get(two).data.status == 'accepted');
    }
    match /emailDirectory/{email} {
      allow get: if registered();
      allow list: if false;
      allow create, update: if registered() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','updatedAt']) && request.resource.data.updatedAt == request.time;
      allow delete: if registered() && resource.data.uid == request.auth.uid;
    }
    match /friendRequests/{id} {
      allow read, delete: if registered() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if registered() && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['from','to','status','createdAt'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && get(/databases/$(database)/documents/profiles/$(request.resource.data.to)).data.guest == false;
      allow update: if registered() && resource.data.to == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'accepted';
    }
    match /duelInvites/{id} {
      allow read, delete: if registered() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if registered() && request.resource.data.keys().hasOnly(['from','to','code','createdAt','expiresAt'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to is string
        && friends(request.auth.uid, request.resource.data.to)
        && request.resource.data.code is string && request.resource.data.code.matches('[A-Z0-9]{4}')
        && request.resource.data.createdAt == request.time && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm');
      allow update: if false;
    }
    match /battleHistory/{uid}/matches/{id} {
      allow read: if registered() && (request.auth.uid == uid || friends(request.auth.uid, uid));
      allow create, update: if registered() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.id == id && request.resource.data.at is number
        && request.resource.data.score is number && request.resource.data.score >= 0
        && request.resource.data.time is number && request.resource.data.time >= 0
        && request.resource.data.mode in ['endless','duel'] && request.resource.data.outcome is string
        && request.resource.data.createdAt == request.time;
      allow delete: if registered() && request.auth.uid == uid;
    }
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid && code.size() == 4;
      allow update: if signedIn() && resource.data.host == request.auth.uid;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
      match /players/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /events/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
